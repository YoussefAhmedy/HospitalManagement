# Copy to an untracked .env file or configure these values in your secret manager.
# Do not put production secrets in this file or commit your local .env.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:8080
ConnectionStrings__DefaultConnection=
AllowedHosts=localhost;127.0.0.1
ForwardedHeaders__KnownProxies__0=
EmailOptions__Enabled=false
EmailOptions__From=
EmailOptions__SmtpServer=
EmailOptions__Port=587
EmailOptions__Password=
Auth__Google__ClientID=
Auth__Google__ClientSecret=
DataProtection__KeysPath=
