@model ForgetPasswordVM
@{
    ViewData["Title"] = "Reset your password";
    ViewData["BodyClass"] = "auth-page";
    ViewData["MainClass"] = "auth-main";
}

<section class="auth-card" aria-labelledby="forgot-heading">
    <span class="eyebrow">Account recovery</span>
    <h1 id="forgot-heading">Reset your password</h1>
    <p class="auth-card__lead">Enter your account email. If an eligible verified account exists, reset instructions will be sent.</p>
    <form asp-action="ForgetPassword" asp-controller="Account" method="post">
        <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>
        <div class="mb-3">
            <label class="form-label" asp-for="Email"></label>
            <input class="form-control" asp-for="Email" type="email" autocomplete="email" inputmode="email" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>
        <button class="button button--primary" type="submit">Send reset instructions</button>
    </form>
    <div class="auth-card__footer">
        <a asp-controller="Account" asp-action="LogIn">Back to sign in</a>
        <a asp-controller="Account" asp-action="Register">Create an account</a>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
