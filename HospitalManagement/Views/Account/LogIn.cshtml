@model LogInViewModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["BodyClass"] = "auth-page";
    ViewData["MainClass"] = "auth-main";
}

<section class="auth-card" aria-labelledby="login-heading">
    <span class="eyebrow">Welcome back</span>
    <h1 id="login-heading">Sign in to CareAxis</h1>
    <p class="auth-card__lead">Use your account to open your role-specific workspace.</p>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="status-message" role="status">@statusMessage</div>
    }

    <form asp-action="LogIn" asp-controller="Account" method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>
        <div class="mb-3">
            <label class="form-label" asp-for="Email"></label>
            <input class="form-control" asp-for="Email" type="email" autocomplete="username" inputmode="email" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Password"></label>
            <input class="form-control" asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" asp-for="RememberMe" />
            <label class="form-check-label" asp-for="RememberMe"></label>
        </div>
        <button class="button button--primary w-100" type="submit">Sign in</button>
    </form>

    @if (Model.ExternalLogins?.Any(scheme => scheme.Name == "Google") == true)
    {
        <div class="auth-divider"><span>or continue with</span></div>
        <a class="button w-100" asp-controller="Account" asp-action="GoogleAuth" asp-route-returnUrl="@Model.ReturnUrl">Continue with Google</a>
    }

    <div class="auth-card__footer">
        <a asp-controller="Account" asp-action="ForgetPassword">Forgot your password?</a>
        <span>New here? <a asp-controller="Account" asp-action="Register">Create an account</a></span>
    </div>
    <p class="form-hint mt-3 mb-0">Sign-in services are available only when configured by the deployment operator.</p>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
