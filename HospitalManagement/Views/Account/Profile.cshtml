@model EditProfileVm
@{
    ViewData["Title"] = "Your account";
}

<section class="container page-header">
    <div class="page-header__eyebrow">Account settings</div>
    <h1>Your profile</h1>
    <p>Update your account details. A requested email change takes effect only after verification.</p>
</section>

<div class="container profile-layout">
    <aside class="profile-summary">
        <img class="avatar-large" src="@Url.Action("ProfileImage", "Account")" alt="Profile image for @Model.FirstName @Model.LastName" />
        <h2>@Model.FirstName @Model.LastName</h2>
        <p>Signed-in account</p>
        <p class="form-hint mt-3">Your profile image is stored outside the public web directory and served to your signed-in account.</p>
    </aside>

    <section class="panel-card" aria-labelledby="profile-form-heading">
        <div class="panel-card__heading">
            <div><h2 id="profile-form-heading">Personal details</h2><p>Only change information you are authorized to maintain.</p></div>
        </div>
        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="status-message" role="status">@statusMessage</div>
        }
        <form asp-action="EditProfile" asp-controller="Account" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>
            <div class="form-grid">
                <div>
                    <label class="form-label" asp-for="FirstName"></label>
                    <input class="form-control" asp-for="FirstName" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="field-validation-error"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="LastName"></label>
                    <input class="form-control" asp-for="LastName" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="field-validation-error"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="Email"></label>
                    <input class="form-control" asp-for="Email" type="email" autocomplete="email" inputmode="email" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                    <p class="form-hint">A confirmation link is sent to the new address when delivery is configured.</p>
                </div>
                <div>
                    <label class="form-label" asp-for="PhoneNumber"></label>
                    <input class="form-control" asp-for="PhoneNumber" type="tel" autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="DateOfBirth"></label>
                    <input class="form-control" asp-for="DateOfBirth" type="date" autocomplete="bday" />
                    <span asp-validation-for="DateOfBirth" class="field-validation-error"></span>
                </div>
                <div>
                    <label class="form-label" asp-for="Gender"></label>
                    <select class="form-select" asp-for="Gender">
                        <option value="">Select an option</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                        <option value="Prefer not to say">Prefer not to say</option>
                    </select>
                    <span asp-validation-for="Gender" class="field-validation-error"></span>
                </div>
                <div class="form-grid__full">
                    <label class="form-label" for="imageFile">Profile image</label>
                    <input class="form-control" type="file" id="imageFile" name="imageFile" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                    <p class="form-hint">JPG, PNG, or WebP, up to 5 MB. The server checks the file signature and type.</p>
                </div>
            </div>
            <div class="form-actions">
                <button class="button button--primary" type="submit">Save profile</button>
                <a class="button" asp-controller="Home" asp-action="Index">Cancel</a>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
