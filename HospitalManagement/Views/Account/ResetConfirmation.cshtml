@model ForgetPasswordVM
@{
    ViewData["Title"] = "Password reset requested";
    ViewData["BodyClass"] = "auth-page";
    ViewData["MainClass"] = "auth-main";
}

<section class="auth-card" aria-labelledby="reset-confirmation-heading">
    <span class="eyebrow">Account recovery</span>
    <h1 id="reset-confirmation-heading">Check your inbox</h1>
    <p class="auth-card__lead">@((TempData["PasswordResetNotice"] as string) ?? "If an eligible account exists for the address, reset instructions will be sent shortly.")</p>
    <div class="notice-placeholder mb-4">For privacy, this page does not confirm whether an account exists. Reset links are delivered only when email is configured for the deployment.</div>
    <form asp-action="ResendPasswordReset" asp-controller="Account" method="post">
        <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>
        <div class="mb-3">
            <label class="form-label" asp-for="Email"></label>
            <input class="form-control" asp-for="Email" type="email" autocomplete="email" inputmode="email" />
            <span asp-validation-for="Email" class="field-validation-error"></span>
        </div>
        <button class="button button--primary" type="submit">Resend reset instructions</button>
    </form>
    <div class="auth-card__footer"><a asp-controller="Account" asp-action="LogIn">Back to sign in</a></div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
