@model ResetPasswordVM
@{
    ViewData["Title"] = "Choose a new password";
    ViewData["BodyClass"] = "auth-page";
    ViewData["MainClass"] = "auth-main";
}

<section class="auth-card" aria-labelledby="reset-heading">
    <span class="eyebrow">Account recovery</span>
    <h1 id="reset-heading">Choose a new password</h1>
    <p class="auth-card__lead">Use a unique password you do not use on another site.</p>
    <form asp-action="ResetPassword" asp-controller="Account" method="post">
        <div asp-validation-summary="All" class="validation-summary-errors" role="alert"></div>
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Code" />
        <div class="mb-3">
            <label class="form-label" asp-for="Password"></label>
            <input class="form-control" asp-for="Password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-validation-error"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="ConfrimPassword"></label>
            <input class="form-control" asp-for="ConfrimPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfrimPassword" class="field-validation-error"></span>
        </div>
        <button class="button button--primary" type="submit">Update password</button>
    </form>
    <div class="auth-card__footer"><a asp-controller="Account" asp-action="LogIn">Return to sign in</a></div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
