@model List<DoctorVm>
@{
    ViewData["Title"] = "Clinicians";
}

<section class="container page-header">
    <div class="page-header__eyebrow">Administration</div>
    <h1>Clinicians</h1>
    <p>Manage clinician profiles configured for this deployment.</p>
</section>

<section class="container section pt-0" aria-label="Clinician directory">
    <div class="dashboard-actions">
        <a class="button button--primary" asp-action="CreateDoctor" asp-controller="Admin">Create clinician account</a>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state">No clinician accounts are available.</div>
    }
    else
    {
        <div class="data-table-wrap">
            <table class="table table-hover">
                <thead><tr><th scope="col">Clinician</th><th scope="col">Specialization</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                    @foreach (var doctor in Model)
                    {
                        var initials = string.Concat(doctor.FirstName?.FirstOrDefault(), doctor.LastName?.FirstOrDefault()).ToUpperInvariant();
                        <tr>
                            <td><div class="table-person"><span class="table-person__avatar table-person__avatar--clinician" aria-hidden="true">@(string.IsNullOrWhiteSpace(initials) ? "DR" : initials)</span><span>Dr. @doctor.FirstName @doctor.LastName</span></div></td>
                            <td>@(doctor.Specialization ?? "Not configured")</td>
                            <td class="text-end"><a class="button button--small" asp-action="getDoctorDetails" asp-controller="Admin" asp-route-id="@doctor.Id">Edit profile</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
