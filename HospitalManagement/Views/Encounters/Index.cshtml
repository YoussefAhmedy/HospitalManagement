@model Hospital.BLL.Common.PagedResult<Hospital.BLL.Services.Abstraction.EncounterListItem>
@{
    string? status = ViewBag.Status;
    string? term = ViewBag.Term;
    string? patientId = ViewBag.PatientId;
    var queue = (Hospital.BLL.Services.Abstraction.EncounterQueueCounts)ViewBag.Queue;
    var statuses = new[] { "Registered", "Triaged", "InConsultation", "Completed", "Signed", "Cancelled" };
}

<div class="kpi-grid" style="margin-bottom:var(--space-5)">
    <article class="kpi kpi--attention">
        <div class="kpi__label">Awaiting triage</div>
        <div class="kpi__value">@queue.Waiting</div>
        <div class="kpi__hint">Registered, no vitals yet</div>
    </article>
    <article class="kpi kpi--info">
        <div class="kpi__label">Triaged</div>
        <div class="kpi__value">@queue.Triaged</div>
        <div class="kpi__hint">Ready for consultation</div>
    </article>
    <article class="kpi">
        <div class="kpi__label">In consultation</div>
        <div class="kpi__value">@queue.InConsultation</div>
        <div class="kpi__hint">Active with a clinician</div>
    </article>
    <article class="kpi kpi--neutral">
        <div class="kpi__label">Completed today</div>
        <div class="kpi__value">@queue.CompletedToday</div>
        <div class="kpi__hint">Awaiting signature or signed</div>
    </article>
</div>

<div class="filter-bar">
    <form method="get" asp-action="Index" style="display:flex;gap:var(--space-3);align-items:flex-end;flex-wrap:wrap;flex:1">
        <div class="field field--grow">
            <label class="field__label" for="term">Search</label>
            <input class="input input--sm" id="term" name="term" value="@term" type="search" placeholder="Encounter, patient name or MRN" />
        </div>
        <div class="field">
            <label class="field__label" for="status">Status</label>
            <select class="select select--sm" id="status" name="status">
                <option value="">All states</option>
                @foreach (var option in statuses)
                {
                    <option value="@option" selected="@(status == option)">@System.Text.RegularExpressions.Regex.Replace(option, "(\\B[A-Z])", " $1")</option>
                }
            </select>
        </div>
        @if (patientId is not null)
        {
            <input type="hidden" name="patientId" value="@patientId" />
        }
        <button class="btn btn--primary btn--sm" type="submit">Apply</button>
        <a class="btn btn--quiet btn--sm" asp-action="Index">Reset</a>
    </form>
</div>

<div class="card card--flush">
    <div class="card__header">
        <div>
            <h2 class="card__title">Encounter register</h2>
            <p class="card__subtitle">@Model.TotalCount encounters</p>
        </div>
    </div>
    @if (Model.Items.Count == 0)
    {
        <partial name="_EmptyState" model="@(("No encounters match", "Change the filters, or start an encounter from a patient chart.", "stethoscope"))" />
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Encounter</th>
                        <th scope="col">Patient</th>
                        <th scope="col">Clinician</th>
                        <th scope="col">Department</th>
                        <th scope="col">Type</th>
                        <th scope="col">Status</th>
                        <th scope="col">Registered</th>
                        <th scope="col" class="actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var badge = Hospital.BLL.Common.StatusTone.Encounter(item.Status);
                        <tr>
                            <td class="mono">@item.Number</td>
                            <td class="strong">@item.PatientName<span class="table__sub">@item.Mrn</span></td>
                            <td>@(item.DoctorName ?? "Unassigned")</td>
                            <td>@(item.Department ?? "—")</td>
                            <td>@item.Type</td>
                            <td><partial name="_StatusBadge" model="badge" /></td>
                            <td class="nowrap muted">@item.RegisteredAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="actions"><a class="btn btn--sm" asp-action="Details" asp-route-id="@item.Id">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing @(((Model.Page - 1) * Model.PageSize) + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount)) of @Model.TotalCount</span>
            <partial name="_Pager" model="@HospitalManagement.Models.PagerModel.From(
                new Dictionary<string, string?> { ["term"] = term, ["status"] = status, ["patientId"] = patientId, ["pageSize"] = Model.PageSize.ToString() },
                Model.Page, Model.TotalPages, Model.TotalCount, Model.PageSize)" />
        </div>
    }
</div>
