@using Hospital.BLL.Helpers
@model MainVm
@{
    ViewData["Title"] = "Care coordination, made clearer";
    ViewData["Description"] = "A healthcare workflow demonstration for appointment requests, clinician review, and authorized record access.";
    var doctors = Model?.Doctors?.Take(6).ToList() ?? [];
}

<section class="hero">
    <div class="container hero__grid">
        <div>
            <span class="eyebrow">Care coordination platform</span>
            <h1>Better organized care starts with <em>clear next steps.</em></h1>
            <p class="hero__copy">CareAxis brings appointment requests, clinician review, and authorized health-record workflows into one considered experience.</p>
            <div class="hero__actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    if (User.IsInRole(Role.Patient.ToString()))
                    {
                        <a class="button button--primary" asp-controller="Patient" asp-action="AddAppointment">Request an appointment <span aria-hidden="true">→</span></a>
                        <a class="button" asp-controller="Patient" asp-action="Index">Open patient overview</a>
                    }
                    else if (User.IsInRole(Role.Doctor.ToString()))
                    {
                        <a class="button button--primary" asp-controller="Doctor" asp-action="Index">Open clinician workspace <span aria-hidden="true">→</span></a>
                    }
                    else
                    {
                        <a class="button button--primary" asp-controller="Admin" asp-action="Index">Open operations <span aria-hidden="true">→</span></a>
                    }
                }
                else
                {
                    <a class="button button--primary" asp-controller="Account" asp-action="Register">Create a patient account <span aria-hidden="true">→</span></a>
                    <a class="button" asp-controller="Account" asp-action="LogIn">Sign in</a>
                }
            </div>
            <p class="hero__footnote">Demonstration software only. Not for emergencies, diagnosis, or treatment decisions.</p>
        </div>
        <div class="hero__visual" aria-label="Illustration of a care coordination dashboard">
            <div class="care-card">
                <div class="care-card__top">
                    <div>
                        <div class="care-card__label">Your workspace</div>
                        <div class="care-card__title">Care, in one place</div>
                    </div>
                    <span class="demo-badge">Illustrative preview</span>
                </div>
                <div class="care-card__appointment">
                    <div class="date-tile"><strong>01</strong><span>Request</span></div>
                    <div><strong>Appointment request</strong><small>Submit a preferred date and clinician</small></div>
                </div>
                <div class="care-card__list" aria-label="Example workflow stages">
                    <div class="care-card__row"><span><i class="dot" aria-hidden="true"></i> Clinician review</span><span class="status-pill status-pill--pending">Pending</span></div>
                    <div class="care-card__row"><span><i class="dot dot--blue" aria-hidden="true"></i> Appointment updates</span><span>In your dashboard</span></div>
                    <div class="care-card__row"><span><i class="dot dot--gold" aria-hidden="true"></i> Health records</span><span>Role-scoped access</span></div>
                </div>
                <p class="form-hint mb-0 mt-3">Example labels only — no real patient information.</p>
            </div>
        </div>
    </div>
</section>

<section class="section" id="how-it-works">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">Designed around the workflow</span>
            <h2>Simple steps. Clear responsibilities.</h2>
            <p>The demonstration keeps the main tasks visible while limiting each role to its intended workspace.</p>
        </div>
        <div class="feature-grid">
            <article class="feature-card">
                <div class="feature-icon" aria-hidden="true">01</div>
                <h3>Request a visit</h3>
                <p>Patients can request a date with a clinician who has an assigned schedule, then follow the request from their own account.</p>
            </article>
            <article class="feature-card">
                <div class="feature-icon" aria-hidden="true">02</div>
                <h3>Review the schedule</h3>
                <p>Clinicians see their own appointments, review pending requests, and update the appointment status.</p>
            </article>
            <article class="feature-card">
                <div class="feature-icon" aria-hidden="true">03</div>
                <h3>Keep records scoped</h3>
                <p>Patient and clinician record views are filtered to the signed-in account and its authorized relationships.</p>
            </article>
        </div>
    </div>
</section>

<section class="section section--tint" id="care-team">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">Care team</span>
            <h2>Meet the clinicians in this workspace.</h2>
            <p>Clinician details are shown only when configured by an administrator. No contact details or profile photos are published here.</p>
        </div>
        @if (doctors.Count > 0)
        {
            <div class="doctor-grid">
                @foreach (var doctor in doctors)
                {
                    var initials = string.Concat(doctor.FirstName?.FirstOrDefault(), doctor.LastName?.FirstOrDefault()).ToUpperInvariant();
                    <article class="doctor-card">
                        <div class="doctor-card__avatar" aria-hidden="true">@(string.IsNullOrWhiteSpace(initials) ? "CA" : initials)</div>
                        <h3>Dr. @doctor.FirstName @doctor.LastName</h3>
                        <p>@(doctor.SpecializationName ?? "Care team clinician")</p>
                        @if (User.IsInRole(Role.Patient.ToString()))
                        {
                            <a class="button button--small" asp-controller="Patient" asp-action="GetDoctorDetails" asp-route-id="@doctor.Id">View availability <span aria-hidden="true">→</span></a>
                        }
                    </article>
                }
            </div>
        }
        else
        {
            <div class="empty-state">Clinician profiles will appear here after an administrator configures them.</div>
        }
    </div>
</section>

<section class="section section--sand">
    <div class="container">
        <div class="callout">
            <div>
                <h2>Ready to see your own care workspace?</h2>
                <p>Sign in to continue, or create a patient account to explore the demonstration workflow.</p>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="button button--primary" asp-controller="Account" asp-action="Profile">Manage your account</a>
            }
            else
            {
                <a class="button button--primary" asp-controller="Account" asp-action="Register">Create patient account</a>
            }
        </div>
        <p class="form-hint mt-3">CareAxis is a software demonstration. It is not an emergency service and is not represented as legally or clinically certified.</p>
    </div>
</section>
