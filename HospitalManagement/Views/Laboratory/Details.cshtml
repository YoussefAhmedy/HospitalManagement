@model Hospital.DAL.Entities.Diagnostics.LabOrder
@using Hospital.DAL.Entities.Diagnostics
@{
    bool canEnter = ViewBag.CanEnter;
    bool canVerify = ViewBag.CanVerify;
    bool canRelease = ViewBag.CanRelease;
    bool canCollect = ViewBag.CanCollect;
    var badge = Hospital.BLL.Common.StatusTone.Lab(Model.Status);
    var released = Model.Status == LabOrderStatus.Released;
    var statuses = Enum.GetNames<LabOrderStatus>();
    var transitions = Hospital.BLL.Common.Rules.LabRules.Transitions.TryGetValue(Model.Status, out var allowed) ? allowed : Array.Empty<LabOrderStatus>();
}

@section PageActions {
    <partial name="_StatusBadge" model="badge" />
    @if (canCollect && transitions.Contains(LabOrderStatus.Collected))
    {
        <form asp-action="Transition" asp-route-id="@Model.Id" method="post">
            <input type="hidden" name="target" value="Collected" />
            <button class="btn btn--primary" type="submit">Mark collected</button>
        </form>
    }
    @if (canCollect && transitions.Contains(LabOrderStatus.Received))
    {
        <form asp-action="Transition" asp-route-id="@Model.Id" method="post">
            <input type="hidden" name="target" value="Received" />
            <button class="btn" type="submit">Receive specimen</button>
        </form>
    }
    @if (canEnter && transitions.Contains(LabOrderStatus.Processing))
    {
        <form asp-action="Transition" asp-route-id="@Model.Id" method="post">
            <input type="hidden" name="target" value="Processing" />
            <button class="btn" type="submit">Start analysis</button>
        </form>
    }
    @if (canVerify && transitions.Contains(LabOrderStatus.AwaitingVerification))
    {
        <form asp-action="Transition" asp-route-id="@Model.Id" method="post" data-confirm="Submit all entered results for verification?">
            <input type="hidden" name="target" value="AwaitingVerification" />
            <button class="btn" type="submit">Submit for verification</button>
        </form>
    }
    @if (canRelease && transitions.Contains(LabOrderStatus.Released))
    {
        <form asp-action="Transition" asp-route-id="@Model.Id" method="post" data-confirm="Release these results to the clinical record? Released results are final.">
            <input type="hidden" name="target" value="Released" />
            <button class="btn btn--navy" type="submit">Verify &amp; release</button>
        </form>
    }
}

<div class="split-grid">
    <div class="stack">
        <section class="card card--flush" aria-labelledby="results-heading">
            <div class="card__header">
                <div>
                    <h2 class="card__title" id="results-heading">Results</h2>
                    <p class="card__subtitle">@(released ? "Released — final and immutable." : "Not yet released. Values are provisional and must not be treated as final.")</p>
                </div>
            </div>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">Test</th>
                            <th scope="col">Reference</th>
                            <th scope="col">Result</th>
                            <th scope="col">Flag</th>
                            <th scope="col">Entered</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var flag = Hospital.BLL.Common.StatusTone.Result(item.Flag);
                            var reference = item.LabTest is null ? "—"
                                : item.LabTest.NormalLow is null && item.LabTest.NormalHigh is null ? "—"
                                : $"{item.LabTest.NormalLow?.ToString("0.##") ?? "–"} – {item.LabTest.NormalHigh?.ToString("0.##") ?? "–"} {item.LabTest.Unit}";
                            <tr>
                                <td class="strong">@item.LabTest?.Name<span class="table__sub">@item.LabTest?.Code</span></td>
                                <td class="muted nowrap">@reference</td>
                                <td class="mono">@(item.ResultValue ?? "—") @item.LabTest?.Unit</td>
                                <td><partial name="_StatusBadge" model="flag" /></td>
                                <td class="nowrap muted">@(item.EnteredAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @if (canEnter && !released && Model.Status is LabOrderStatus.Received or LabOrderStatus.Processing or LabOrderStatus.AwaitingVerification)
        {
            <section class="card" aria-labelledby="entry-heading">
                <div class="card__header"><h2 class="card__title" id="entry-heading">Enter a result</h2></div>
                <div class="card__body">
                    <form asp-action="EnterResult" asp-route-id="@Model.Id" method="post" style="display:grid;gap:var(--space-2)">
                        <div class="field">
                            <label class="field__label" for="orderItemId">Test</label>
                            <select class="select" id="orderItemId" name="orderItemId" required>
                                @foreach (var item in Model.Items)
                                {
                                    <option value="@item.Id">@item.LabTest?.Name</option>
                                }
                            </select>
                        </div>
                        <div style="display:flex;gap:var(--space-2)">
                            <input class="input input--sm" name="value" placeholder="Value (text)" aria-label="Result value" />
                            <input class="input input--sm" name="numericValue" type="number" step="0.0001" placeholder="Numeric value" aria-label="Numeric result" />
                        </div>
                        <input class="input input--sm" name="comment" placeholder="Comment (optional)" aria-label="Comment" />
                        <span class="field__hint">The abnormal/critical flag is derived from the configured reference range and must be verified by laboratory staff.</span>
                        <button class="btn btn--sm btn--primary" type="submit">Save result</button>
                    </form>
                </div>
            </section>
        }
    </div>

    <div class="stack">
        <section class="card">
            <div class="card__header"><h2 class="card__title">Order details</h2></div>
            <div class="card__body">
                <dl class="dl">
                    <dt>Order</dt><dd class="mono">@Model.Number</dd>
                    <dt>Patient</dt><dd>@Model.Patient?.FirstName @Model.Patient?.LastName · @Model.Patient?.Mrn</dd>
                    <dt>Encounter</dt><dd><a asp-controller="Encounters" asp-action="Details" asp-route-id="@Model.EncounterId">@Model.Encounter?.Number</a></dd>
                    <dt>Specimen</dt><dd class="mono">@(Model.SpecimenId ?? "Not collected")</dd>
                    <dt>Collected</dt><dd>@(Model.CollectedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                    <dt>Received</dt><dd>@(Model.ReceivedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                    <dt>Released</dt><dd>@(Model.ReleasedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</dd>
                </dl>
                @if (!string.IsNullOrWhiteSpace(Model.ClinicalNotes))
                {
                    <p class="card__subtitle" style="margin-top:var(--space-3)">@Model.ClinicalNotes</p>
                }
            </div>
        </section>

        <section class="card">
            <div class="card__header"><h2 class="card__title">Workflow</h2></div>
            <div class="card__body">
                <ul class="timeline">
                    @foreach (var step in new[] { LabOrderStatus.AwaitingCollection, LabOrderStatus.Collected, LabOrderStatus.Received, LabOrderStatus.Processing, LabOrderStatus.AwaitingVerification, LabOrderStatus.Released })
                    {
                        var reached = (int)step <= (int)Model.Status && Model.Status != LabOrderStatus.Cancelled;
                        <li class="timeline__item">
                            <span class="timeline__dot" style="border-color:@(reached ? "var(--teal-500)" : "var(--line-300)")" aria-hidden="true"></span>
                            <span class="timeline__body">
                                <span class="timeline__title" style="@(reached ? "" : "color:var(--ink-400)")">@System.Text.RegularExpressions.Regex.Replace(step.ToString(), "(\\B[A-Z])", " $1")</span>
                            </span>
                        </li>
                    }
                </ul>
            </div>
        </section>
    </div>
</div>
