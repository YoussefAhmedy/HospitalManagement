@{
    var prescriptions = (Hospital.BLL.Common.PagedResult<Hospital.DAL.Entities.Pharmacy.Prescription>)ViewBag.Prescriptions;
    var kpis = (IReadOnlyList<Hospital.BLL.Services.Abstraction.Kpi>)ViewBag.Kpis;
    string? status = ViewBag.Status;
    string? term = ViewBag.Term;
    var statuses = Enum.GetNames<Hospital.DAL.Entities.Pharmacy.PrescriptionStatus>();
}

<partial name="_KpiGrid" model="kpis" />

<div class="filter-bar" style="margin-top:var(--space-5)">
    <form method="get" asp-action="Index" style="display:flex;gap:var(--space-3);align-items:flex-end;flex-wrap:wrap;flex:1">
        <div class="field field--grow">
            <label class="field__label" for="term">Search</label>
            <input class="input input--sm" id="term" name="term" value="@term" type="search" placeholder="Prescription number or patient" />
        </div>
        <div class="field">
            <label class="field__label" for="status">Status</label>
            <select class="select select--sm" id="status" name="status">
                <option value="">All states</option>
                @foreach (var option in statuses)
                {
                    <option value="@option" selected="@(status == option)">@option</option>
                }
            </select>
        </div>
        <button class="btn btn--primary btn--sm" type="submit">Apply</button>
        <a class="btn btn--quiet btn--sm" asp-action="Index">Reset</a>
    </form>
</div>

<div class="card card--flush">
    <div class="card__header">
        <div>
            <h2 class="card__title">Prescription queue</h2>
            <p class="card__subtitle">@prescriptions.TotalCount prescription@(prescriptions.TotalCount == 1 ? "" : "s") · pharmacist review precedes dispensing</p>
        </div>
    </div>
    @if (prescriptions.Items.Count == 0)
    {
        <partial name="_EmptyState" model="@(("No prescriptions", "Prescriptions entered by clinicians appear here for review.", "pill"))" />
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Prescription</th>
                        <th scope="col">Patient</th>
                        <th scope="col">Medications</th>
                        <th scope="col">Created</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prescription in prescriptions.Items)
                    {
                        var badge = Hospital.BLL.Common.StatusTone.Prescription(prescription.Status);
                        <tr>
                            <td class="mono">@prescription.Number</td>
                            <td class="strong">@prescription.Patient?.FirstName @prescription.Patient?.LastName<span class="table__sub">@prescription.Patient?.Mrn</span></td>
                            <td>@string.Join(", ", prescription.Items.Select(i => i.Medication?.Name).Where(n => n is not null))</td>
                            <td class="nowrap muted">@prescription.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td><partial name="_StatusBadge" model="badge" /></td>
                            <td class="actions"><a class="btn btn--sm" asp-action="Details" asp-route-id="@prescription.Id">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing @(((prescriptions.Page - 1) * prescriptions.PageSize) + 1)–@(Math.Min(prescriptions.Page * prescriptions.PageSize, prescriptions.TotalCount)) of @prescriptions.TotalCount</span>
            <partial name="_Pager" model="@HospitalManagement.Models.PagerModel.From(
                new Dictionary<string, string?> { ["term"] = term, ["status"] = status, ["pageSize"] = prescriptions.PageSize.ToString() },
                prescriptions.Page, prescriptions.TotalPages, prescriptions.TotalCount, prescriptions.PageSize)" />
        </div>
    }
</div>
