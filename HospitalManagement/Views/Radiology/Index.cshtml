@model Hospital.BLL.Common.PagedResult<Hospital.BLL.Services.Abstraction.ImagingWorklistItem>
@{
    string? status = ViewBag.Status;
    string? term = ViewBag.Term;
    var kpis = (IReadOnlyList<Hospital.BLL.Services.Abstraction.Kpi>)ViewBag.Kpis;
    var statuses = Enum.GetNames<Hospital.DAL.Entities.Diagnostics.ImagingOrderStatus>();
}

<partial name="_KpiGrid" model="kpis" />

<div class="filter-bar" style="margin-top:var(--space-5)">
    <form method="get" asp-action="Index" style="display:flex;gap:var(--space-3);align-items:flex-end;flex-wrap:wrap;flex:1">
        <div class="field field--grow">
            <label class="field__label" for="term">Search</label>
            <input class="input input--sm" id="term" name="term" value="@term" type="search" placeholder="Study, patient or MRN" />
        </div>
        <div class="field">
            <label class="field__label" for="status">Status</label>
            <select class="select select--sm" id="status" name="status">
                <option value="">All states</option>
                @foreach (var option in statuses)
                {
                    <option value="@option" selected="@(status == option)">@option</option>
                }
            </select>
        </div>
        <button class="btn btn--primary btn--sm" type="submit">Apply</button>
        <a class="btn btn--quiet btn--sm" asp-action="Index">Reset</a>
    </form>
</div>

<div class="card card--flush">
    <div class="card__header">
        <div>
            <h2 class="card__title">Imaging worklist</h2>
            <p class="card__subtitle">@Model.TotalCount study(ies) · reports are drafted, verified, then released</p>
        </div>
    </div>
    @if (Model.Items.Count == 0)
    {
        <partial name="_EmptyState" model="@(("No imaging requests", "Requests made during an encounter appear here.", "scan"))" />
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Study</th>
                        <th scope="col">Patient</th>
                        <th scope="col">Modality</th>
                        <th scope="col">Requested</th>
                        <th scope="col">Performed</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var badge = Hospital.BLL.Common.StatusTone.Imaging(item.Status);
                        <tr>
                            <td class="strong">@item.StudyName<span class="table__sub mono">@item.Number</span></td>
                            <td>@item.PatientName<span class="table__sub">@item.Mrn</span></td>
                            <td><span class="chip">@item.Modality</span></td>
                            <td class="nowrap muted">@item.RequestedAtUtc.ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="nowrap muted">@(item.PerformedAtUtc?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                            <td><partial name="_StatusBadge" model="badge" /></td>
                            <td class="actions"><a class="btn btn--sm" asp-action="Details" asp-route-id="@item.Id">Open</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer">
            <span>Showing @(((Model.Page - 1) * Model.PageSize) + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount)) of @Model.TotalCount</span>
            <partial name="_Pager" model="@HospitalManagement.Models.PagerModel.From(
                new Dictionary<string, string?> { ["term"] = term, ["status"] = status, ["pageSize"] = Model.PageSize.ToString() },
                Model.Page, Model.TotalPages, Model.TotalCount, Model.PageSize)" />
        </div>
    }
</div>
