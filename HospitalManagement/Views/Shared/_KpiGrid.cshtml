@model IReadOnlyList<Hospital.BLL.Services.Abstraction.Kpi>
@{
    var links = ViewData["KpiLinks"] as string[];
    var index = 0;
}
@if (Model.Count > 0)
{
    <section class="kpi-grid" aria-label="Key indicators">
        @foreach (var kpi in Model)
        {
            var tone = string.IsNullOrWhiteSpace(kpi.Tone) ? "neutral" : kpi.Tone;
            var href = links is not null && index < links.Length ? links[index] : null;
            index++;
            if (!string.IsNullOrWhiteSpace(href))
            {
                <a class="kpi kpi--@tone" href="@href">
                    <div class="kpi__label">@kpi.Label</div>
                    <div class="kpi__value">@kpi.Value</div>
                    @if (!string.IsNullOrWhiteSpace(kpi.Hint))
                    {
                        <div class="kpi__hint">@kpi.Hint</div>
                    }
                </a>
            }
            else
            {
                <article class="kpi kpi--@tone">
                    <div class="kpi__label">@kpi.Label</div>
                    <div class="kpi__value">@kpi.Value</div>
                    @if (!string.IsNullOrWhiteSpace(kpi.Hint))
                    {
                        <div class="kpi__hint">@kpi.Hint</div>
                    }
                </article>
            }
        }
    </section>
}
